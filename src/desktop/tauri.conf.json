{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkDew",
  "version": "1.2.6",
  "identifier": "dev.markdew.editor",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../.."
    },
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkDew",
        "width": 1000,
        "height": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; frame-src 'self' blob:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Text document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/plain"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/MarkDew.desktop",
        "depends": [
          "pkexec"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNUQ3RkE0NEZCQzlEQ0YKUldUUG5ieFBwSDlkQ3IvVFEvWVBiZEJDOHpGVEdTQjV0NnN0WTZ4YkxSQzB0WEV3Rm52NGpDNmcK",
      "endpoints": [
        "https://github.com/shenghsi/MarkDew/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
